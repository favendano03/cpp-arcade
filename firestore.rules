rules_version = '2';

// Reglas de la base de datos de C++ Arcade.
// Cada jugador solo puede leer y escribir su propio documento users/{uid}.
// Se pegan en Firebase: Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'name', 'xp', 'levels', 'missed', 'created', 'lastPlayed', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 16
        && request.resource.data.xp is number
        && request.resource.data.levels is map
        && request.resource.data.missed is list
        && request.resource.data.missed.size() <= 60;
    }
  }
}
